# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts.bak
# Generated by Next on every dev/build, and the two runs write DIFFERENT
# contents (.next/dev/types vs .next/types), so a committed copy is perpetually
# dirty for whoever ran the other command last. Next regenerates it on first
# run, so ignoring it costs nothing.
next-env.d.ts
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# Docker
pgdata/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Proposal PDFs — not committed
*.pdf

# Graphify structural index (generated)
graphify-out/

# Local agent tooling / installed skills
.agents/
