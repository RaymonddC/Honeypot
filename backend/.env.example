# ── ITTU backend env ─────────────────────────────────────────────────────────
# Copy to `.env` and adjust. All vars use the ITTU_ prefix.
# POC is the safe default — the free demo needs NOTHING here except (in prod)
# ITTU_CORS_ORIGINS + ITTU_JWT_SECRET. Everything else is opt-in.

# ── Core ─────────────────────────────────────────────────────────────────────
# Global mode: poc (in-memory, no keys) or live.
ITTU_MODE=poc
# Per-module MODE override (JSON), e.g. {"takedown":"live"}
# ITTU_MODULE_MODES={}
# Frontend origin(s) allowed to call the API. Accepts a single origin, a
# comma-separated list, or a JSON list. Set to your Vercel URL in prod.
ITTU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# CHANGE THIS IN PROD (>=32 bytes). Render generates one automatically.
ITTU_JWT_SECRET=ittu-dev-only-secret-change-me-in-prod-0123
# ITTU_JWT_ALGORITHM=HS256
# ITTU_JWT_TTL_SECONDS=28800
# LIVE Google OAuth: expected `aud` of the verified id_token.
# ITTU_GOOGLE_CLIENT_ID=

# ── Live voice (opt-in — the browser/POC path needs none of these) ───────────
# TTS provider: browser | elevenlabs | google | higgsfield.
# "browser" = client-side SpeechSynthesis (free). The others synthesize a real,
# browser-independent Bahasa voice and need the matching key below.
ITTU_TTS_PROVIDER=browser
#   To turn on ElevenLabs: grab a free key at https://elevenlabs.io (Profile →
#   API Keys, no card required for the free tier), then set:
#     ITTU_TTS_PROVIDER=elevenlabs
#     ITTU_ELEVENLABS_API_KEY=xi-...
# ITTU_ELEVENLABS_API_KEY=          # natural Bahasa voice (has a free tier)
# ITTU_GOOGLE_TTS_API_KEY=          # alternative TTS provider

# ── Live notifications (uncover module, opt-in) ───────────────────────────────
# Operator-owned webhook: every UNCOVER dispatch (freeze request / STR / case
# alert) is POSTed as JSON to this URL — point it at your own goAML bridge,
# Slack/Teams incoming webhook, or case-management ingest. Unset = LIVE
# dispatch fails loud (never silently falls back to the POC mock sink).
# ITTU_NOTIFICATION_WEBHOOK_URL=https://your-endpoint.example.com/hooks/ittu

# Live LLM brain for the interactive call (/sessions/{id}/turn). Without ANY key,
# the persona uses a deterministic in-character scripted fallback (POC-safe).
# Provider-agnostic (litellm) — pick ONE:
#
#   EASIEST — OpenRouter (one token, access to Claude + many models):
#     ITTU_LLM_API_KEY=sk-or-...
#     ITTU_LLM_MODEL=openrouter/anthropic/claude-3.5-haiku
#
#   OR direct Anthropic:
#     ITTU_LLM_API_KEY=sk-ant-...          # or set the standard ANTHROPIC_API_KEY
#     ITTU_LLM_MODEL=claude-haiku-4-5
#
# Force a custom OpenAI-compatible endpoint (rarely needed — the "openrouter/"
# model prefix already routes automatically):
#   ITTU_LLM_API_BASE=https://openrouter.ai/api/v1

# ── Persistence (only when RLS/persistence goes LIVE — not needed for POC) ────
# ITTU_DATABASE_URL=postgresql+asyncpg://ittu:ittu@localhost:5432/ittu
# ITTU_REDIS_URL=redis://localhost:6379/0
