# ══════════════════════════════════════════════════════════════════════════════
#  ITTU backend — environment template
# ──────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` and set only what you need. Every var uses the ITTU_ prefix.
#
#  POC is the safe default: the free in-memory demo needs NOTHING here. A commented
#  line = the app's built-in default (shown so you know it exists); uncomment only
#  to override. Keep your real `.env` free of these comments — this file is the
#  reference, `.env` is just values.
#
#  Sections:  1) Core   2) Persistence   3) Auth   4) Voice/TTS   5) LLM
#             6) Notifications   7) Blockchain
# ══════════════════════════════════════════════════════════════════════════════


# ── 1. Core ───────────────────────────────────────────────────────────────────
# Global MODE: "poc" (in-memory, no keys, deterministic) or "live".
ITTU_MODE=poc
# Per-module MODE override (JSON), e.g. {"takedown":"live"} to run ONE module live.
# ITTU_MODULE_MODES={}
# Frontend origin(s) allowed to call the API — single origin, comma-separated, or
# a JSON list. Set to your Vercel URL in prod (localhost default is dev-only).
# ITTU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bearer token a metrics scraper must present at GET /metrics (Prometheus text).
# UNSET (the default) DISABLES the endpoint — it 404s, so a deployment without
# metrics is indistinguishable from one that has none. Unlike /health and /ready
# this is NOT safe to leave open: it enumerates every route template and its
# traffic volume. Generate with: openssl rand -hex 32. See docs/Deploy.md §8.
# ITTU_METRICS_TOKEN=


# ── 2. Persistence (only when RLS/durable storage goes LIVE — POC needs none) ──
# Toggle: "memory" (default) = POC, NO database touched at all. "postgres" =
# durable + multi-tenant RLS. Everything below in this section applies only here.
# ITTU_PERSISTENCE=postgres
#
# App connection — the NON-owning `ittu_app` role, so RLS actually filters rows.
# asyncpg URL form: scheme postgresql+asyncpg:// and `?ssl=require` (NOT libpq's
# `sslmode=require`, which asyncpg rejects). For Neon use the `-pooler` host.
# ITTU_DATABASE_URL=postgresql+asyncpg://ittu_app:<pw>@<host>-pooler.<region>.aws.neon.tech/<db>?ssl=require
#
# Owner/migration role — the container entrypoint runs `alembic upgrade head` with
# THIS on deploy (the app role above can't run DDL). Same asyncpg URL form, owner
# credentials. Empty = auto-migration skipped (schema assumed already at head).
# ITTU_MIGRATION_DATABASE_URL=postgresql+asyncpg://<owner>@<host>/<db>?ssl=require
#
# Local (non-Neon) examples:
# ITTU_DATABASE_URL=postgresql+asyncpg://ittu:ittu@localhost:5432/ittu
# ITTU_REDIS_URL=redis://localhost:6379/0


# ── 3. Auth (JWT — we always mint our own {sub, agency_id, role, exp}) ─────────
# CHANGE THIS IN PROD (>=32 bytes for HS256). Render auto-generates one.
# ITTU_JWT_SECRET=ittu-dev-only-secret-change-me-in-prod-0123
# ITTU_JWT_ALGORITHM=HS256
# Session length AND the revocation window for a deactivated user (see UAM).
# Default 3600 (1h). There is no refresh flow — raising this lengthens how long
# a revoked token keeps working; lowering it means more re-logins.
# ITTU_JWT_TTL_SECONDS=3600
# LIVE Google OAuth (see docs/OAuth-Live-Validation.md):
#   ITTU_GOOGLE_CLIENT_ID — required in LIVE; the expected `aud` of the id_token
#   (without it the endpoint fails loud instead of skipping audience checks).
# ITTU_GOOGLE_CLIENT_ID=
#   ITTU_OAUTH_PROVISION — operator allowlist (JSON) mapping real Google emails
#   to an agency slug + role. No self-service signup: an email logs in only if
#   seeded OR listed here.
# ITTU_OAUTH_PROVISION=[{"email":"you@gmail.com","agency":"bareskrim","role":"police-investigator"}]


# ── 4. Voice / TTS (opt-in — the browser/POC path needs none of these) ────────
# Provider: browser | elevenlabs | gemini | google | higgsfield.
#   "browser" (default) = client-side SpeechSynthesis, free, no key.
#   The others synthesize a real, browser-independent Bahasa voice and need the
#   matching key below. Selecting one WITHOUT its key fails loud (by design).
# ITTU_TTS_PROVIDER=browser
# ITTU_ELEVENLABS_API_KEY=xi-...      # best raw quality; free plan is tiny (~10k
#                                     # credits ≈ 10 min/mo) + non-commercial → $6/mo Starter for real use
# ITTU_ELEVENLABS_MODEL=eleven_flash_v2_5   # low-latency default; eleven_multilingual_v2 = higher quality/slower
# ITTU_ELEVENLABS_VOICE_PERSONA=21m00Tcm4TlvDq8ikWAM  # a voice ID FROM YOUR ElevenLabs library (Voices page)
# ITTU_ELEVENLABS_VOICE_SCAMMER=pNInz6obpgDQGcFmaJgB
# ITTU_GEMINI_API_KEY=...             # Gemini TTS (AI Studio) — style-controlled persona,
#                                     # free tier (non-commercial); key at aistudio.google.com
# ITTU_GOOGLE_TTS_API_KEY=...         # Google Cloud TTS (id-ID WaveNet) — 1M chars/mo free,
#                                     # forever + COMMERCIAL-OK (the standout free option)


# ── 5. LLM (live persona brain, paid + opt-in) ────────────────────────────────
# Engaged only when INFILTRATE is live / a session is interactive AND a key exists.
# Without any key the persona uses a deterministic scripted fallback (POC-safe).
# Provider-agnostic (litellm) — pick ONE:
#
#   OpenRouter (one token → Claude + many models):
#     ITTU_LLM_API_KEY=sk-or-...
#     ITTU_LLM_MODEL=openrouter/anthropic/claude-3.5-haiku
#
#   Direct Anthropic:
#     ITTU_LLM_API_KEY=sk-ant-...     # or the standard ANTHROPIC_API_KEY
#     ITTU_LLM_MODEL=claude-haiku-4-5
#
#   Custom OpenAI-compatible gateway (only if the model prefix can't route it):
#     ITTU_LLM_API_BASE=https://your-gateway/v1
# ITTU_LLM_MODEL=claude-haiku-4-5
# ITTU_LLM_API_KEY=
# ITTU_LLM_API_BASE=


# ── 6. Notifications (UNCOVER module, opt-in) ─────────────────────────────────
# Operator-owned webhook: every UNCOVER dispatch (freeze request / STR / case
# alert) is POSTed as JSON here — point it at your goAML bridge, Slack/Teams
# incoming webhook, or case-management ingest. Unset = LIVE dispatch fails loud
# (never silently falls back to the POC mock sink).
# ITTU_NOTIFICATION_WEBHOOK_URL=https://your-endpoint.example.com/hooks/ittu
# HMAC-SHA256 signing key. Set it and every dispatch carries an
# `X-ITTU-Signature: t=<ts>,v1=<hex>` header the recipient verifies (proves the
# packet is genuinely ITTU's + not a replay). Recommended for any cross-org
# agency webhook; may be omitted only on a trusted internal endpoint.
# ITTU_NOTIFICATION_WEBHOOK_SECRET=change-me-shared-with-the-recipient
# Delivery engine: "sync" (default) POSTs inline during the dispatch request;
# "worker" persists each notification as queued and hands delivery to the
# `dispatch_notifications` Dramatiq actor (durable, retried, off-request) —
# requires ITTU_PERSISTENCE=postgres + a running `dramatiq app.workers` + Redis.
# ITTU_NOTIFICATION_DELIVERY=sync
# ITTU_NOTIFICATION_MAX_RETRIES=3
# ITTU_NOTIFICATION_RETRY_BACKOFF_MS=30000


# ── 7. Blockchain (TAKEDOWN module, optional) ─────────────────────────────────
# TRONSCAN API key — strongly recommended once takedown=live. The public API is
# keyless but rate-limits hard (429s on any real trace); a key raises the limit on
# the TRONSCAN primary. Free: tronscan.org → Profile → API Keys (no card). (The
# TronGrid fallback is a separate provider and stays anonymous — its key is different.)
# ITTU_TRONSCAN_API_KEY=


# ── 8. Outbound dialing + Twilio telephony (voice honeypot) ───────────────────
# docs/Voice-Honeypot-Outbound.md · docs/Live-Voice-Calls.md
#
# Starting a campaign only places calls when BOTH of the following hold — and
# both fail SILENTLY, so check them first when "Start" appears to do nothing:
#   1. ITTU_DIAL_ENQUEUE_ON_START=true   (read at BOOT — restart the API)
#   2. ITTU_PERSISTENCE=postgres         (the actor loads its row cross-process)
# plus a running `dramatiq app.workers` + Redis. GET /api/config reports the
# resolved state as `dialing.enabled`.
# ITTU_DIAL_ENQUEUE_ON_START=false
# ITTU_DIAL_MAX_RETRIES=3
# ITTU_DIAL_RETRY_BACKOFF_MS=30000

# Twilio — phase-5 groundwork. With these UNSET nothing is dialed for real: POC
# simulates outcomes and LIVE fails loud. Setting them does NOT enable real
# calls on its own (the media bridge is still unbuilt), but it does enable the
# answer webhook, which is how you verify the whole path end to end.
# Get them at console.twilio.com (trial: ~$15 credit + a number; calls only to
# numbers you have verified, which is exactly right for self-testing).
# ITTU_TWILIO_ACCOUNT_SID=
# ITTU_TWILIO_AUTH_TOKEN=

# Public origin Twilio reaches this API on, e.g. https://ittu-api.onrender.com
# REQUIRED for webhooks once Twilio is set: Twilio signs the exact public URL it
# called, but Render/Fly terminate TLS upstream and hand the app an internal
# http:// host — so without this, a URL rebuilt from the request won't match and
# every genuine webhook is rejected as forged (403). Locally, use your tunnel's
# URL (ngrok/cloudflared), not http://localhost:8000 — Twilio must reach it.
# ITTU_PUBLIC_BASE_URL=

# Point your Twilio number's "A CALL COMES IN" webhook at:
#   POST  https://<ITTU_PUBLIC_BASE_URL>/api/telephony/voice
# It is intentionally unauthenticated — the X-Twilio-Signature HMAC IS the auth,
# and it fails closed, so an unset ITTU_TWILIO_AUTH_TOKEN rejects everything.
