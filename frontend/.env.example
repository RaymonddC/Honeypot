# ── ITTU frontend env ────────────────────────────────────────────────────────
# Copy to .env.local for local dev; set these in the Vercel project settings for
# deploy (Project → Settings → Environment Variables). All are NEXT_PUBLIC_ (safe
# to expose — no secrets live here; provider API keys stay server-side).

# Base URL of the ITTU backend API (FastAPI). Leave pointing at a not-yet-live
# backend and the app runs in OFFLINE/MOCK mode (every screen renders on demo
# data + an "offline" badge, and login offers "Continue offline — demo session").
# For a LIVE demo, set this to your deployed backend, e.g. https://ittu-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mode badge fallback when /api/config is unreachable (poc | live).
NEXT_PUBLIC_ITTU_MODE=poc

# Google OAuth client ID — browser-side copy, enables the "Continue with Google"
# button (Google Identity Services). SAME value as the backend's
# ITTU_GOOGLE_CLIENT_ID; NOT a secret (no client secret is used — id_token flow).
# Unset = the Google button stays disabled. The page's origin must be an
# Authorized JavaScript origin on the OAuth client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Voice call defaults (the Control Panel / user settings override these) ────
# Default voice provider: browser | elevenlabs | google.
# "browser" = client-side SpeechSynthesis (free; needs Chrome/Edge for id-ID).
# The others play server-synthesized audio (requires the backend key + provider).
NEXT_PUBLIC_VOICE_PROVIDER=browser

# Default call mode on /honeypot/call: scripted | live-mic.
# live-mic uses the browser SpeechRecognition API (Chrome/Edge only; other
# browsers fall back to typing).
NEXT_PUBLIC_CALL_MODE=scripted
